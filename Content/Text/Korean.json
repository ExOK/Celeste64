			},
			{
				"Face": "signpost",
				"Voice": "sign/general_06",
				"Text": "까다로운 배치를 넘기 위한 가장 좋은 방법은\n알맞은 카메라 각도를 찾는 거니까요."
			},
			{
				"Face": "signpost",
				"Voice": "sign/snark_02",
				"Text": "그럼 출발!"
			}
		],
		"Sign2": [
			{
				"Face": "signpost",
				"Voice": "sign/general_01",
